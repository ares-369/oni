# OniOps secrets - copy to .env and fill in (scripts/install.sh does this for you).
# NEVER commit .env. Only set keys for the providers/integrations you actually use.
# Keep comments on their own lines: a comment after a value can be read as part of
# the value by some tools (systemd EnvironmentFile, docker --env-file).

# --- LLM provider API keys (optional; Ollama needs none) ---
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
AZURE_OPENAI_API_KEY=
OPENAI_COMPAT_API_KEY=

# --- Web UI authentication (set auth.mode in config.yaml) ---
# Password for auth.mode basic/local (or use auth.password_hash in config.yaml).
ONIOPS_AUTH_PASSWORD=
# Random 32+ bytes. Signs sessions (local/oidc), assessment manifests and webhook
# alerts. Unset = manifests and webhooks are unsigned. scripts/install.sh generates
# one for you if this is empty. Keep it the same across restarts.
ONIOPS_SECRET_KEY=
# For auth.mode oidc.
OIDC_CLIENT_SECRET=

# --- Optional integrations ---
MISP_API_KEY=
CALDERA_API_KEY=

# --- Optional: override the SSH key path from config.yaml ---
# ONIOPS_KALI_SSH_KEY=/opt/oniops/secrets/kali_id_rsa
