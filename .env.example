# ONIOPS secrets — copy to .env and fill in. NEVER commit .env.
# Only set keys for the providers/integrations you actually use.

# --- LLM provider API keys (optional; Ollama needs none) ---
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
AZURE_OPENAI_API_KEY=
OPENAI_COMPAT_API_KEY=

# --- Web UI authentication (set auth.enabled: true in config.yaml) ---
ONIOPS_AUTH_PASSWORD=

# --- Optional integrations ---
MISP_API_KEY=
CALDERA_API_KEY=

# --- Optional: override the SSH key path from config.yaml ---
# ONIOPS_KALI_SSH_KEY=/opt/oniops/secrets/kali_id_rsa
