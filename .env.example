# OniOps secrets — copy to .env and fill in. NEVER commit .env.
# Only set keys for the providers/integrations you actually use.

# --- LLM provider API keys (optional; Ollama needs none) ---
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
AZURE_OPENAI_API_KEY=
OPENAI_COMPAT_API_KEY=

# --- Web UI authentication (set auth.mode in config.yaml) ---
ONIOPS_AUTH_PASSWORD=       # for mode: basic/local (or use auth.password_hash)
ONIOPS_SECRET_KEY=          # session signing for mode: local/oidc (random 32+ bytes); also signs
                         # assessment manifests and webhook alerts. Unset = those are unsigned.
OIDC_CLIENT_SECRET=      # for mode: oidc

# --- Optional integrations ---
MISP_API_KEY=
CALDERA_API_KEY=

# --- Optional: override the SSH key path from config.yaml ---
# ONIOPS_KALI_SSH_KEY=/opt/oniops/secrets/kali_id_rsa
